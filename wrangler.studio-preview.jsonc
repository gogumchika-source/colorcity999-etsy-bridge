{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "colorcity999-listing-studio-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "STUDIO_ENABLED": "preview",
    "STUDIO_ISOLATED": "true"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
