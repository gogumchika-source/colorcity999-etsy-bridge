{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "colorcity999-listing-studio-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "STUDIO_ENABLED": "preview",
    "STUDIO_ISOLATED": "true",
    "STUDIO_ETSY_SHOP_ID": "51212373"
  },
  "durable_objects": { "bindings": [{ "name": "STUDIO_ACCOUNT", "class_name": "StudioAccount" }] },
  "migrations": [{ "tag": "studio-account-v1", "new_sqlite_classes": ["StudioAccount"] }],
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}

